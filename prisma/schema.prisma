generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Format {
  PRINT
  KINDLE
  AUDIO
}

enum NomStatus {
  ACTIVE
  SELECTED
  ARCHIVED
}

enum VoteType {
  UP
  DOWN
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  progressPublic       Boolean          @default(true)
  onboardingCompleted  Boolean          @default(false)
  accounts          Account[]
  sessions          Session[]
  readingSessions   ReadingSession[]
  suggestedBooks    Book[]             @relation("SuggestedBooks")
  meetingRatings    MeetingRating[]
  availability      MemberAvailability[]
  nominations       BookNomination[]
  nominationVotes   NominationVote[]
  activityPhotos    ActivityPhoto[]    @relation("UploadedPhotos")
  galleryComments   GalleryComment[]   @relation("GalleryComments")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Book {
  id              String           @id @default(cuid())
  title           String
  author          String?
  coverUrl        String?
  googleBooksId   String?
  totalPages      Int?
  totalMinutes    Int?
  format          Format           @default(PRINT)
  isActive        Boolean          @default(true)
  meetingId       String?
  meeting         Meeting?         @relation(fields: [meetingId], references: [id])
  suggestedByUserId String?
  suggestedBy     User?            @relation("SuggestedBooks", fields: [suggestedByUserId], references: [id])
  readingSessions ReadingSession[]
  createdAt       DateTime         @default(now())

  @@map("books")
}

model Meeting {
  id         String           @id @default(cuid())
  date       DateTime
  location   String?
  activity   String?
  notes      String?
  archivedAt DateTime?
  books      Book[]
  ratings    MeetingRating[]
  photos     ActivityPhoto[]
  comments   GalleryComment[]
  createdAt  DateTime         @default(now())

  @@map("meetings")
}

model ActivityPhoto {
  id               String   @id @default(cuid())
  meetingId        String
  url              String
  caption          String?
  uploadedByUserId String
  meeting          Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploadedBy       User     @relation("UploadedPhotos", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@map("activity_photos")
}

model GalleryComment {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  text      String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation("GalleryComments", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("gallery_comments")
}

model MeetingRating {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  icons     String[] @map("emojis")
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([meetingId, userId])
  @@map("meeting_ratings")
}

model MemberAvailability {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("member_availability")
}

model ReadingSession {
  id       String   @id @default(cuid())
  userId   String
  bookId   String
  page     Int?
  percent  Float?
  loggedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("reading_sessions")
}

model BookNomination {
  id                String           @id @default(cuid())
  title             String
  author            String?
  coverUrl          String?
  googleBooksId     String?
  blurb             String
  gbDescription     String?
  gbRating          Float?
  gbRatingCount     Int?
  status            NomStatus        @default(ACTIVE)
  nominatedByUserId String
  nominatedBy       User             @relation(fields: [nominatedByUserId], references: [id], onDelete: Cascade)
  votes             NominationVote[]
  createdAt         DateTime         @default(now())

  @@map("book_nominations")
}

model NominationVote {
  id             String         @id @default(cuid())
  nominationId   String
  userId         String
  voteType       VoteType       @default(UP)
  nomination     BookNomination @relation(fields: [nominationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@unique([nominationId, userId])
  @@map("nomination_votes")
}
