generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Format {
  PRINT
  KINDLE
  AUDIO
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  progressPublic  Boolean          @default(true)
  accounts          Account[]
  sessions          Session[]
  readingSessions   ReadingSession[]
  suggestedBooks    Book[]             @relation("SuggestedBooks")
  meetingRatings    MeetingRating[]
  availability      MemberAvailability[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Book {
  id              String           @id @default(cuid())
  title           String
  author          String?
  coverUrl        String?
  openLibraryId   String?
  totalPages      Int?
  totalMinutes    Int?
  format          Format           @default(PRINT)
  isActive        Boolean          @default(true)
  meetingId       String?
  meeting         Meeting?         @relation(fields: [meetingId], references: [id])
  suggestedByUserId String?
  suggestedBy     User?            @relation("SuggestedBooks", fields: [suggestedByUserId], references: [id])
  readingSessions ReadingSession[]
  createdAt       DateTime         @default(now())

  @@map("books")
}

model Meeting {
  id         String          @id @default(cuid())
  date       DateTime
  location   String?
  notes      String?
  archivedAt DateTime?
  books      Book[]
  ratings    MeetingRating[]
  createdAt  DateTime        @default(now())

  @@map("meetings")
}

model MeetingRating {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  emojis    String[]
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([meetingId, userId])
  @@map("meeting_ratings")
}

model MemberAvailability {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("member_availability")
}

model ReadingSession {
  id       String   @id @default(cuid())
  userId   String
  bookId   String
  page     Int?
  percent  Float?
  loggedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("reading_sessions")
}
